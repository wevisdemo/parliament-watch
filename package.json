{
	"name": "parliament-watch",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "husky",
		"dev": "pnpm run gen:graphql && vite dev",
		"build": "pnpm run gen:graphql && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "ESLINT_USE_FLAT_CONFIG=true eslint --fix .",
		"format": "prettier --write .",
		"test": "vitest",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"sass:build": "sass --load-path=node_modules --style=compressed --no-source-map src/styles/carbon/index.scss src/styles/carbon/pre-compiled.css",
		"story:dev": "histoire dev",
		"story:build": "HISTOIRE_BASE=/stories/ histoire build",
		"story:preview": "histoire preview",
		"gen:graphql": "genql --endpoint https://politigraph.wevis.info/graphql --output src/lib/politigraph/genql -S Date:string -S DateTime:string",
		"gen:component": "hygen component new",
		"update:politician-ranking": "tsx src/lib/politician-ranking/run-update-job.ts"
	},
	"lint-staged": {
		"*.md": "doctoc --github --update-only",
		"*.{js,ts,svelte}": "eslint --fix",
		"*": "prettier --write --ignore-unknown"
	},
	"dependencies": {
		"@melt-ui/svelte": "^0.86.6",
		"@wevisdemo/ui": "^8.1.0",
		"d3": "^7.9.2",
		"d3-array": "^3.2.5",
		"d3-dsv": "^3.0.2",
		"d3-scale-chromatic": "^3.1.1",
		"d3-shape": "^3.2.1",
		"dayjs": "^1.11.23",
		"fastest-levenshtein": "^1.0.16",
		"keen-slider": "^6.8.6",
		"lru-cache": "^11.5.3",
		"pino": "^10.4.0",
		"pino-pretty": "^13.2.0",
		"scrollama": "^3.2.0",
		"sheethuahua": "^4.0.1",
		"tailwind-merge": "^2.6.1"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@eslint/js": "^10.0.1",
		"@genql/cli": "^6.3.4",
		"@histoire/plugin-svelte": "https://pkg.pr.new/histoire-dev/histoire/@histoire/plugin-svelte@607e09e87a278ede3c5ce2f733c21c5f8e1545f9",
		"@sveltejs/adapter-node": "^5.5.8",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@trivago/prettier-plugin-sort-imports": "^4.3.0",
		"@types/d3": "^7.4.3",
		"@types/d3-array": "^3.2.2",
		"@types/d3-dsv": "^3.0.7",
		"@types/d3-scale-chromatic": "^3.1.0",
		"@types/d3-shape": "^3.2.0",
		"@types/md5": "^2.3.6",
		"@types/node": "^26.6.6",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"autoprefixer": "^10.6.2",
		"carbon-components": "^10.58.15",
		"carbon-components-svelte": "^0.109.0",
		"carbon-icons-svelte": "^13.18.0",
		"doctoc": "^2.5.0",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"histoire": "https://pkg.pr.new/histoire-dev/histoire/histoire@607e09e87a278ede3c5ce2f733c21c5f8e1545f9",
		"husky": "^9.1.7",
		"hygen": "^6.2.11",
		"lint-staged": "^17.6.0",
		"postcss": "^8.5.32",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sass": "^1.108.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-eslint-parser": "^1.10.1",
		"tailwindcss": "^3.4.19",
		"tslib": "^2.9.1",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6",
		"vite-plugin-devtools-json": "^1.1.2",
		"vitest": "^5.1.0"
	},
	"packageManager": "pnpm@10.25.0"
}
